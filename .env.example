# ---- LLM / Embedding providers ----
# Leave provider keys empty to run in OFFLINE mode (deterministic local stubs).
# This lets ingestion, retrieval, and the naive/hardened chat contract run in CI
# and local dev with no external API calls. Set real keys for production quality.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# claude-sonnet-4-6 in the original spec is stale. Current Sonnet id is claude-sonnet-5.
LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=bge-reranker-v2

# ---- Infrastructure ----
DATABASE_URL=postgresql+asyncpg://ragguard:ragguard@localhost:5432/ragguard
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE=pgvector

# ---- Retrieval / generation tuning ----
CHUNK_STRATEGY=recursive
CHUNK_SIZE_DEFAULT=500
RETRIEVE_TOP_K=25
RERANK_TOP_N=5
CONFIDENCE_THRESHOLD=0.4
MAX_TOKENS=1000
TEMPERATURE=0.2

# ---- Security mode: the whole point of InjectionRange ----
# naive    = intentionally weak baseline (no trust boundary, no validation, no limits)
# hardened = trust-boundary framing, injection-resistant prompt, groundedness gate,
#            confidence fallback, rate limiting, output budget
RAG_SECURITY_MODE=hardened

# ---- Canary / protected values (FAKE — never real secrets) ----
# These mirror VectorGuard's `protected:` config so its detectors have real bait.
CANARY_SECRET_TOKEN=RAGGUARD_CANARY_TOKEN_PLACEHOLDER
CANARY_POLICY_NAME=RAGGUARD_POLICY_ALPHA
CANARY_INTERNAL_EMAIL=admin@ragguard.local
CANARY_SYSTEM_MARKER=RAGGUARD_SYSTEM_MARKER

# ---- Auth ----
JWT_SECRET=change-me-in-production-please
JWT_EXPIRE_MINUTES=1440

# ---- Rate limiting (hardened mode only) ----
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10
